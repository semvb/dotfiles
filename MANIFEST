# Which files in this repo get symlinked where.
#
#   <path in repo>                     -> ~/<same path>
#   <path in repo> -> <path in $HOME>  -> when the names differ
#
# Lines starting with # are ignored, so you can disable an entry by commenting it out.

config/emacs/init.el   -> .config/emacs/init.el
config/emacs/.emacs.rc -> .config/emacs/.emacs.rc
config/emacs/lisp      -> .config/emacs/lisp

config/i3              -> .config/i3

config/kitty           -> .config/kitty

config/rofi            -> .config/rofi

.bashrc
